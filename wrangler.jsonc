{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "open-seo",
	"main": "src/server.ts",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
	},
	"vars": {
		"AUTH_MODE": "cloudflare_access",
		"TEAM_DOMAIN": "https://lenux28.cloudflareaccess.com",
		"POLICY_AUD": "02658f24aad054ef41701ae807642754886abff3af7b6e1308591e4fe790f3d9",
		"OPENAI_CONTENT_MODEL": "gpt-5-2025-08-07",
	},
	"routes": [
		{
			"pattern": "app.lenux28.cloud",
			"custom_domain": true,
		},
	],
	"triggers": {
		"crons": [
			"*/15 * * * *"
		],
	},
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "e08aad30d3444062b4d2d01b42c5981d",
		},
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "open seo fork",
			"database_id": "c0631610-e726-4dc9-817f-04668f443992",
			"migrations_dir": "drizzle",
		},
	],
	"r2_buckets": [
		{
			"bucket_name": "open-seo",
			"binding": "R2",
		},
	],
}
