# -----------------------------------------------------------------------------
# OpenSEO client-side sandbox
# -----------------------------------------------------------------------------
# Copy this file only when you want a local sandbox setup:
# cp .env.sandbox.example .env.local
#
# The /sandbox route does not call DataForSEO or write to the database.
# Keep it on mock data unless you intentionally wire a gated beta flow.

AUTH_MODE=local_noauth
PORT=3001
VITE_SHOW_DEVTOOLS=false

# Leave this empty for the client-only sandbox.
# When moving to a real integration, use a dedicated sandbox/test key first.
DATAFORSEO_API_KEY=

# Production keys should be set outside the repo:
# - Local: .env.local
# - Docker: .env
# - Cloudflare: Worker secrets/bindings
